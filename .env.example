# Copy this file to .env and fill in your values
# cp .env.example .env

# PRADAN portal credentials (for Aditya-L1 data download)
PRADAN_USERNAME=your_username_here
PRADAN_PASSWORD=your_password_here

# API server settings
API_HOST=0.0.0.0
API_PORT=8000

# Model settings
LATENT_DIM=64
WINDOW_SIZE=300
ANOMALY_THRESHOLD=0.3

# Alert settings
ALERT_ZSCORE_THRESHOLD=3.0
ALERT_FLARE_PROB_THRESHOLD=0.6
FORECAST_LEAD_MINUTES=10
